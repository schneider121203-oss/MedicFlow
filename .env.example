# Runtime
ENVIRONMENT=development
APP_NAME=MediFlow
APP_VERSION=0.1.0

# Database (development values only)
DATABASE_URL=postgresql://mediflow:change_me@localhost:55432/mediflow

# Authentication: generate with `openssl rand -hex 32`
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REGISTRATION_ENABLED=false

# Browser origins, comma separated
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI
GEMINI_API_KEY=
WHISPER_MODEL=base

# Files
UPLOAD_DIR=uploads
MAX_AUDIO_SIZE_MB=50

# Phase 1 infrastructure
REDIS_URL=redis://localhost:56379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mediflow
S3_SECRET_KEY=replace_me
S3_BUCKET=mediflow-dev
